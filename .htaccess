<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS when SSL is active on the Hostinger domain.
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Keep application internals and source files out of the web root.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|vendor)(/|$) - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|\.env.*)$ - [F,L,NC]

    # Serve Laravel from the public directory when public_html is the domain root.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex public/index.php index.php index.html
</IfModule>
